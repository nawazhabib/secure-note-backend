PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db_username>:<url_encoded_password>@<cluster-host>/care_guide_notes?retryWrites=true&w=majority
JWT_SECRET=<generate-a-random-secret-at-least-32-characters-long>
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password-at-least-12-characters-long>
